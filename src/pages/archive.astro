---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, groupByYear, formatDate, getPostUrl } from '../lib/posts';

const posts = await getPublishedPosts();
const groups = groupByYear(posts);
---

<BaseLayout title="归档">
  <h1 style={{ fontSize: '1.5rem', marginBottom: '2rem' }}>归档</h1>

  {groups.length === 0 ? (
    <div class="empty">
      <p>暂无文章</p>
    </div>
  ) : (
    groups.map(([year, yearPosts]) => (
      <div class="archive-group">
        <h2 class="archive-year">{year}</h2>
        <ul class="post-list">
          {yearPosts.map((post) => (
            <li>
              <a href={getPostUrl(post)}>
                <span class="post-meta" style={{ marginRight: '0.75rem' }}>
                  {formatDate(post.data.date).replace(/年.*$/, '')}
                </span>
                <span class="post-title" style={{ fontSize: '1rem', display: 'inline' }}>
                  {post.data.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  )}
</BaseLayout>
