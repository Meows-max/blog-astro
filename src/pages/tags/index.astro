---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, groupByTag } from '../../lib/posts';
import { withBase } from '../../lib/url';

const posts = await getPublishedPosts();
const groups = groupByTag(posts);
---

<BaseLayout title="标签">
  <h1 style={{ fontSize: '1.5rem', marginBottom: '2rem' }}>标签</h1>

  {groups.length === 0 ? (
    <div class="empty">
      <p>暂无标签</p>
    </div>
  ) : (
    <div style={{ display: 'flex', flexWrap: 'wrap', gap: '0.5rem' }}>
      {groups.map(([tag, tagPosts]) => (
        <a href={withBase(`/tags/${tag}/`)} class="tag" style={{ fontSize: '0.875rem', padding: '0.375rem 0.875rem' }}>
          #{tag}
          <span style={{ opacity: 0.6, marginLeft: '0.25rem' }}>({tagPosts.length})</span>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
