---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { formatDate, getPostUrl } from '../lib/posts';
import { withBase } from '../lib/url';

interface Props {
  post: CollectionEntry<'posts'>;
  prev?: CollectionEntry<'posts'> | null;
  next?: CollectionEntry<'posts'> | null;
}

const { post, prev, next } = Astro.props;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        {post.data.tags.length > 0 && (
          <span style={{ marginLeft: '0.75rem' }}>
            {post.data.tags.map((tag) => (
              <a class="tag" href={withBase(`/tags/${tag}/`)}>#{tag}</a>
            ))}
          </span>
        )}
      </div>
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>

  <nav class="post-nav">
    {prev ? (
      <a class="prev" href={getPostUrl(prev)}>
        <span class="label">← 上一篇</span>
        {prev.data.title}
      </a>
    ) : <span />}
    {next ? (
      <a class="next" href={getPostUrl(next)}>
        <span class="label">下一篇 →</span>
        {next.data.title}
      </a>
    ) : <span />}
  </nav>
</BaseLayout>
